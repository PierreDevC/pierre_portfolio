# Copy this file to ".env" for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Required: your Resend API key (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where contact-form submissions are delivered.
# Defaults to pscypre@gmail.com if unset.
CONTACT_TO_EMAIL=pscypre@gmail.com

# Optional: the "from" address shown on the email.
# Must be on a domain you've verified in Resend.
# Until you verify your own domain, leave this as the Resend sandbox address.
CONTACT_FROM_EMAIL=onboarding@resend.dev
